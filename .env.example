# Copy this file to .env and fill in real values. Never commit .env.

# Twilio — https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The Twilio phone number that SENDS the demo SMS, E.164 format (e.g. +14155551234)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# The real, verified phone number that should RECEIVE the demo SMS, E.164 format
TO_PHONE_NUMBER=+1XXXXXXXXXX

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Optional. Defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional
PORT=3000
# Set to "false" to skip Twilio webhook signature verification during local
# testing (e.g. before you have an ngrok URL registered on the Twilio number).
TWILIO_VALIDATE_SIGNATURE=true

# "sms" (default) or "whatsapp". Use "whatsapp" to send/receive via the Twilio
# WhatsApp Sandbox -- no A2P 10DLC compliance registration needed, works
# immediately. When set to "whatsapp", TWILIO_PHONE_NUMBER should be the
# Sandbox number Twilio gives you (Console -> Messaging -> Try it out ->
# Send a WhatsApp message), and TO_PHONE_NUMBER should be your own WhatsApp
# number -- but you must first send "join <your-sandbox-code>" from that
# WhatsApp number to the Sandbox number to opt in (one-time, per recipient).
MESSAGING_CHANNEL=sms

# Only used if NGROK_AUTHTOKEN is set here for convenience -- ngrok itself
# reads from its own config file, not from this app. Get one free at
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Cartesia — https://play.cartesia.ai (used only by voiceover.js, optional,
# not required for the demo app itself)
CARTESIA_API_KEY=sk_car_xxxxxxxxxxxxxxxxxxxx
# Your own cloned voice's ID -- voiceover.js will refuse to fall back to a
# stock voice if this is missing or rejected by the API.
CARTESIA_VOICE_ID=
